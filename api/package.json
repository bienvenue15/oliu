{
  "name": "@oliu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OLIU API — Express 5 + Prisma + PostgreSQL. Every business rule lives here.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:start": "tsx scripts/db-start.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "lint": "eslint src test scripts prisma/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oliu/shared": "*",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "nodemailer": "^7.0.6",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-socket": "^0.2.14",
    "@eslint/js": "^9.37.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.37.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
