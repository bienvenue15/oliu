# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3001
# Local PostgreSQL (PGlite) started by `npm run db:start` on port 5433. With docker compose: postgresql://oliu:oliu_dev_only@localhost:5432/oliu
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres?connection_limit=1&pgbouncer=true
# At least 32 random characters in production:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-development-secret-0123456789
SESSION_DAYS=7
OTP_MINUTES=10
WEB_URL=http://localhost:3000
# memory = keep mail on this machine (http://localhost:3001/dev/mail); smtp = send through SMTP_URL
MAIL_TRANSPORT=memory
# SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM=OLIU <no-reply@oliu.local>
COOKIE_SECURE=false
