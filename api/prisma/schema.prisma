// OLIU — spine tables (roadmap slice 1).
// Every table carries the account it belongs to; company-bound tables carry the company.
// Later slices add their own tables in their own files' worth of models, never by widening these.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- accounts & companies

/// One paying tenant: a single company (with branches) or a group of partner companies working as one.
model Account {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  package       Package
  /// Stage at which the responsible company flips (groups only).
  handoverStage Stage?
  status        AccountStatus @default(ACTIVE)
  createdAt     DateTime @default(now())

  companies     Company[]
  users         User[]
  featureSwitches FeatureSwitch[]
  auditEvents   AuditEvent[]
  shippingLines ShippingLine[]
  clients       Client[]
  bookings      Booking[]
  containers    Container[]
  mdQueueItems  MdQueueItem[]
}

enum Package {
  SINGLE
  GROUP
}

enum AccountStatus {
  ACTIVE
  READ_ONLY
  SUSPENDED
}

/// A legal company (MAIN or PARTNER, own book) or a BRANCH of one (same book as its parent).
model Company {
  id          String      @id @default(uuid()) @db.Uuid
  accountId   String      @db.Uuid
  account     Account     @relation(fields: [accountId], references: [id])
  legalName   String
  country     String      @db.VarChar(2)
  currency    String      @db.VarChar(3)
  tin         String      @default("")
  address     String      @default("")
  kind        CompanyKind
  parentId    String?     @db.Uuid
  parent      Company?    @relation("Branches", fields: [parentId], references: [id])
  branches    Company[]   @relation("Branches")
  /// Exactly one company per account raises the client invoices.
  billsClient Boolean     @default(false)
  createdAt   DateTime    @default(now())

  bankAccounts BankAccount[]
  users        User[]
  bookings     Booking[]

  @@index([accountId])
}

enum CompanyKind {
  MAIN
  BRANCH
  PARTNER
}

/// Prints on invoices. Changing one needs a second approval (four-eyes) — the pending fields hold the proposal.
model BankAccount {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @db.Uuid
  companyId   String   @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id])
  bank        String
  number      String
  currency    String   @db.VarChar(3)
  swift       String   @default("")
  active      Boolean  @default(true)
  pendingChange Json?
  pendingBy   String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([accountId, companyId])
}

/// Which modules are on for an account (and optionally one company). Off hides screens; rows are never deleted.
model FeatureSwitch {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id])
  companyId String?  @db.Uuid
  feature   String
  enabled   Boolean  @default(true)

  @@unique([accountId, companyId, feature])
}

// ---------------------------------------------------------------- people

/// One person, one role, in one company or (MD, Reporting Officer) in all.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  accountId    String     @db.Uuid
  account      Account    @relation(fields: [accountId], references: [id])
  companyId    String?    @db.Uuid
  company      Company?   @relation(fields: [companyId], references: [id])
  name         String
  email        String
  role         Role
  passwordHash String?
  /// The department mailbox that receives the one-time code — never a personal inbox by default.
  otpMailbox   String
  status       UserStatus @default(INVITED)
  createdAt    DateTime   @default(now())

  sessions     Session[]
  otpChallenges OtpChallenge[]
  tokens       ActionToken[]

  @@unique([accountId, email])
  @@index([accountId, companyId])
}

enum Role {
  MD
  OPS_MANAGER
  FINANCE_OFFICER
  TRANSPORT_COORDINATOR
  FIELD_OFFICER
  REPORTING_OFFICER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

/// A signed-in browser. The cookie carries only this id, signed; everything else is looked up here.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime
  lastSeen  DateTime @default(now())
  ip        String   @default("")
  userAgent String   @default("")

  @@index([userId])
}

/// Password accepted, waiting for the six-digit code sent to the department mailbox.
model OtpChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

/// One-use links: set a password after an invitation, reset a forgotten one.
model ActionToken {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id])
  purpose   TokenPurpose
  tokenHash String      @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())
}

enum TokenPurpose {
  SET_PASSWORD
  RESET_PASSWORD
}

// ---------------------------------------------------------------- audit

/// Append-only. A database trigger (see the migration) refuses UPDATE and DELETE on this table.
model AuditEvent {
  id        BigInt   @id @default(autoincrement())
  accountId String   @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id])
  userId    String?  @db.Uuid
  companyId String?  @db.Uuid
  module    String
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String   @default("")
  at        DateTime @default(now())

  @@index([accountId, at])
  @@index([accountId, entity, entityId])
}

enum Stage {
  BOOKED
  TRANSPORT
  FIELD_RELEASE
  RUSUMO
  CHECKPOINTS
  ICD
  PORT
  OCEAN_FREIGHT
}

// ---------------------------------------------------------------- shipments (slice 2)

/// A carrier. Its booking numbers have a shape; its boxes usually carry certain owner codes.
model ShippingLine {
  id               String   @id @default(uuid()) @db.Uuid
  accountId        String   @db.Uuid
  account          Account  @relation(fields: [accountId], references: [id])
  name             String
  /// Owner codes (the first four letters) this line's boxes usually carry. Another code is accepted with a note.
  usualPrefixes    String[] @default([])
  referenceHint    String   @default("")
  /// A regular expression a booking number must match; empty accepts anything.
  referencePattern String   @default("")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  bookings Booking[]

  @@unique([accountId, name])
}

/// Who is shipped for and, from slice 8, invoiced.
model Client {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id])
  name      String
  legalName String   @default("")
  tin       String   @default("")
  address   String   @default("")
  country   String   @default("") @db.VarChar(2)
  createdAt DateTime @default(now())

  bookings Booking[]

  @@unique([accountId, name])
}

/// A list of boxes under one shipping-line booking number, made by one company of the account.
model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  accountId      String        @db.Uuid
  account        Account       @relation(fields: [accountId], references: [id])
  companyId      String        @db.Uuid
  company        Company       @relation(fields: [companyId], references: [id])
  shippingLineId String        @db.Uuid
  shippingLine   ShippingLine  @relation(fields: [shippingLineId], references: [id])
  clientId       String        @db.Uuid
  client         Client        @relation(fields: [clientId], references: [id])
  /// The shipping line's booking number.
  reference      String
  cargo          String
  destination    String        @default("")
  vessel         String        @default("")
  voyage         String        @default("")
  status         BookingStatus @default(BOOKED)
  createdById    String        @db.Uuid
  createdAt      DateTime      @default(now())

  containers Container[]

  @@unique([accountId, reference])
  @@index([accountId, companyId, createdAt])
}

enum BookingStatus {
  BOOKED
}

/// One box. An account holds one ACTIVE record per number (partial unique index, see the migration);
/// a second entry is saved as a DUPLICATE beside it and goes to the MD.
model Container {
  id            String          @id @default(uuid()) @db.Uuid
  accountId     String          @db.Uuid
  account       Account         @relation(fields: [accountId], references: [id])
  bookingId     String          @db.Uuid
  booking       Booking         @relation(fields: [bookingId], references: [id])
  number        String          @db.VarChar(11)
  size          String          @db.VarChar(5)
  lot           String          @default("")
  stage         Stage           @default(BOOKED)
  status        ContainerStatus @default(ACTIVE)
  /// For a DUPLICATE: the ACTIVE record it collided with.
  duplicateOfId String?         @db.Uuid
  createdById   String          @db.Uuid
  createdAt     DateTime        @default(now())

  @@index([accountId, number])
  @@index([bookingId])
}

enum ContainerStatus {
  ACTIVE
  DUPLICATE
  WITHDRAWN
}

/// What only the MD rules on. Slice 2 puts duplicate containers here; later slices add their own kinds.
model MdQueueItem {
  id           String      @id @default(uuid()) @db.Uuid
  accountId    String      @db.Uuid
  account      Account     @relation(fields: [accountId], references: [id])
  companyId    String?     @db.Uuid
  kind         String
  entity       String
  entityId     String      @db.Uuid
  summary      Json
  status       QueueStatus @default(OPEN)
  resolution   String?
  resolvedById String?     @db.Uuid
  resolvedAt   DateTime?
  createdById  String      @db.Uuid
  createdAt    DateTime    @default(now())

  @@index([accountId, status, createdAt])
}

enum QueueStatus {
  OPEN
  RESOLVED
}
