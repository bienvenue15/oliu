// OLIU — spine tables (roadmap slice 1).
// Every table carries the account it belongs to; company-bound tables carry the company.
// Later slices add their own tables in their own files' worth of models, never by widening these.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- accounts & companies

/// One paying tenant: a single company (with branches) or a group of partner companies working as one.
model Account {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  package       Package
  /// Stage at which the responsible company flips (groups only).
  handoverStage Stage?
  status        AccountStatus @default(ACTIVE)
  createdAt     DateTime @default(now())

  companies     Company[]
  users         User[]
  featureSwitches FeatureSwitch[]
  auditEvents   AuditEvent[]
}

enum Package {
  SINGLE
  GROUP
}

enum AccountStatus {
  ACTIVE
  READ_ONLY
  SUSPENDED
}

/// A legal company (MAIN or PARTNER, own book) or a BRANCH of one (same book as its parent).
model Company {
  id          String      @id @default(uuid()) @db.Uuid
  accountId   String      @db.Uuid
  account     Account     @relation(fields: [accountId], references: [id])
  legalName   String
  country     String      @db.VarChar(2)
  currency    String      @db.VarChar(3)
  tin         String      @default("")
  address     String      @default("")
  kind        CompanyKind
  parentId    String?     @db.Uuid
  parent      Company?    @relation("Branches", fields: [parentId], references: [id])
  branches    Company[]   @relation("Branches")
  /// Exactly one company per account raises the client invoices.
  billsClient Boolean     @default(false)
  createdAt   DateTime    @default(now())

  bankAccounts BankAccount[]
  users        User[]

  @@index([accountId])
}

enum CompanyKind {
  MAIN
  BRANCH
  PARTNER
}

/// Prints on invoices. Changing one needs a second approval (four-eyes) — the pending fields hold the proposal.
model BankAccount {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @db.Uuid
  companyId   String   @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id])
  bank        String
  number      String
  currency    String   @db.VarChar(3)
  swift       String   @default("")
  active      Boolean  @default(true)
  pendingChange Json?
  pendingBy   String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([accountId, companyId])
}

/// Which modules are on for an account (and optionally one company). Off hides screens; rows are never deleted.
model FeatureSwitch {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id])
  companyId String?  @db.Uuid
  feature   String
  enabled   Boolean  @default(true)

  @@unique([accountId, companyId, feature])
}

// ---------------------------------------------------------------- people

/// One person, one role, in one company or (MD, Reporting Officer) in all.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  accountId    String     @db.Uuid
  account      Account    @relation(fields: [accountId], references: [id])
  companyId    String?    @db.Uuid
  company      Company?   @relation(fields: [companyId], references: [id])
  name         String
  email        String
  role         Role
  passwordHash String?
  /// The department mailbox that receives the one-time code — never a personal inbox by default.
  otpMailbox   String
  status       UserStatus @default(INVITED)
  createdAt    DateTime   @default(now())

  sessions     Session[]
  otpChallenges OtpChallenge[]
  tokens       ActionToken[]

  @@unique([accountId, email])
  @@index([accountId, companyId])
}

enum Role {
  MD
  OPS_MANAGER
  FINANCE_OFFICER
  TRANSPORT_COORDINATOR
  FIELD_OFFICER
  REPORTING_OFFICER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

/// A signed-in browser. The cookie carries only this id, signed; everything else is looked up here.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime
  lastSeen  DateTime @default(now())
  ip        String   @default("")
  userAgent String   @default("")

  @@index([userId])
}

/// Password accepted, waiting for the six-digit code sent to the department mailbox.
model OtpChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

/// One-use links: set a password after an invitation, reset a forgotten one.
model ActionToken {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id])
  purpose   TokenPurpose
  tokenHash String      @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())
}

enum TokenPurpose {
  SET_PASSWORD
  RESET_PASSWORD
}

// ---------------------------------------------------------------- audit

/// Append-only. A database trigger (see the migration) refuses UPDATE and DELETE on this table.
model AuditEvent {
  id        BigInt   @id @default(autoincrement())
  accountId String   @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id])
  userId    String?  @db.Uuid
  companyId String?  @db.Uuid
  module    String
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String   @default("")
  at        DateTime @default(now())

  @@index([accountId, at])
  @@index([accountId, entity, entityId])
}

enum Stage {
  BOOKED
  TRANSPORT
  FIELD_RELEASE
  RUSUMO
  CHECKPOINTS
  ICD
  PORT
  OCEAN_FREIGHT
}
