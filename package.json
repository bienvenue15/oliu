{
  "name": "oliu",
  "version": "0.1.0",
  "private": true,
  "description": "OLIU — management information system for corridor freight forwarders: operations, payments, reconciliation, invoicing.",
  "workspaces": [
    "shared",
    "api",
    "web"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "db:start": "npm run db:start --workspace api",
    "db:migrate": "npm run db:migrate --workspace api",
    "db:seed": "npm run db:seed --workspace api",
    "test": "npm run test --workspace api",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,vue,js,json,md,yml}\"",
    "docs:pdf": "node docs/build-pdf.mjs",
    "demo:video": "node docs/video/make-video.mjs"
  },
  "devDependencies": {
    "h264-mp4-encoder": "^1.0.12",
    "marked": "^18.1.1",
    "playwright-core": "^1.56.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22"
  }
}
